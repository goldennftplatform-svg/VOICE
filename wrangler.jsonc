{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voice-actor-intake",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "SAMPLES_REPO": "goldennftplatform-svg/VOICE-samples",
    "SAMPLES_BRANCH": "main"
  },
  "ratelimits": [{ "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": false }
}
