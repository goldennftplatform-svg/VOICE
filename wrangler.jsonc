{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voice-actor-intake",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "PREVIEW_CATALOG_URL": "https://raw.githubusercontent.com/goldennftplatform-svg/VOICE/main/public/preview/catalog.json",
    "PUBLIC_INTAKE": "true",
    "SAMPLES_REPO": "goldennftplatform-svg/VOICE-samples",
    "SAMPLES_BRANCH": "main"
  },
  "d1_databases": [{ "binding": "PREVIEW_DB", "database_name": "voice-preview-votes", "database_id": "e7b4e20f-d8f4-4f3c-ae94-580c450047e6", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "VOTE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
